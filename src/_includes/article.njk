{% extends "base.njk" %}

{% block extraCss %}
<link rel="stylesheet" href="/assets/css/article.css">
<link rel="stylesheet" href="/assets/css/ads.css">
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if schemaType == 'NewsArticle' or schemaType == 'BlogPosting' %}{{ schemaType }}{% else %}Article{% endif %}",
  "@id": "{{ site.url }}{{ page.url }}#article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "image": [
    "{{ site.url }}{{ ogImagePath | replace(' ', '%20') }}"
  ],
  "datePublished": "{{ date | isoDate }}",
  "dateModified": "{{ (updated or date) | isoDate }}",
  "author": {
    "@type": "Person",
    "name": "{{ author | default(site.author) }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.icon }}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>
{% endblock %}

{% block content %}
<div class="article-page">
  <div class="container">
    <div class="article-layout">

      <article class="article-body">
        <header class="article-header">
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/category/{{ category | slug }}/">{{ category }}</a>
            <span>›</span>
            <span aria-current="page">{{ title }}</span>
          </nav>

          <a href="/category/{{ category | slug }}/" class="badge">{{ category }}</a>
          <h1 class="article-title">{{ title }}</h1>

          <div class="article-meta">
            <span class="article-meta-item">
              <i data-lucide="calendar"></i>
              <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
            </span>
            <span class="article-meta-item">
              <i data-lucide="clock"></i>
              {{ readingTime }}
            </span>
          </div>
        </header>

        {{ content | safe }}

        <div class="article-footer-ads">
          {% set type = "in-content" %}
          {% include "ad-units.njk" %}
        </div>

        {% set relatedPosts = collections.posts | relatedPosts(category, page.url, 3) %}
        <section class="related-posts-mobile">
          <h3>You might also find helpful:</h3>
          <ul class="related-list">
            {% for post in relatedPosts %}
              <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      </article>

      <aside class="article-sidebar">
        {% set type = "sidebar" %}
        {% include "ad-units.njk" %}

        <div class="sidebar-related">
          <p class="sidebar-related-title">Related Articles</p>
          {% for post in relatedPosts %}
            <a href="{{ post.url }}" class="related-post-link">{{ post.data.title }}</a>
          {% endfor %}
        </div>
      </aside>

    </div>
  </div>
</div>
{% endblock %}

{% block extraJs %}
<script src="/assets/js/article.js" defer></script>
{% endblock %}