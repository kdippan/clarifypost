{% extends "base.njk" %}

{% block extraCss %}
<link rel="stylesheet" href="/assets/css/article.css">
<link rel="stylesheet" href="/assets/css/ads.css">
{% endblock %}

{% block schema %}
{% if schemaType == 'HowTo' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "{{ title }}",
  "description": "{{ description }}",
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}"
  }
}
</script>
{% elif schemaType == 'FAQPage' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": []
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ title }}",
  "description": "{{ description }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}"
  }
}
</script>
{% endif %}
{% endblock %}

{% block content %}
<div class="article-page">
  <div class="container">
    <div class="article-layout">

      <article class="article-body">
        <header class="article-header">
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/category/{{ category | slug }}/">{{ category }}</a>
            <span>›</span>
            <span aria-current="page">{{ title }}</span>
          </nav>

          <a href="/category/{{ category | slug }}/" class="badge">{{ category }}</a>
          <h1 class="article-title">{{ title }}</h1>

          <div class="article-meta">
            <span class="article-meta-item">
              <i data-lucide="calendar"></i>
              <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
            </span>
            <span class="article-meta-item">
              <i data-lucide="clock"></i>
              {{ readingTime }}
            </span>
          </div>
        </header>

        {{ content | safe }}

        <div class="article-footer-ads">
          {% set type = "in-content" %}
          {% include "ad-units.njk" %}
        </div>

        <section class="related-posts-mobile">
          <h3>You might also find helpful:</h3>
          <ul class="related-list">
            {% for post in collections.posts | reverse %}
              {% if post.url != page.url and loop.index <= 3 %}
                <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </section>
      </article>

      <aside class="article-sidebar">
        {% set type = "sidebar" %}
        {% include "ad-units.njk" %}

        <div class="sidebar-related">
          <p class="sidebar-related-title">Related Articles</p>
          {% for post in collections.posts %}
            {% if post.url != page.url and loop.index <= 5 %}
              <a href="{{ post.url }}" class="related-post-link">{{ post.data.title }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </aside>

    </div>
  </div>
</div>
{% endblock %}

{% block extraJs %}
<script src="/assets/js/article.js" defer></script>
{% endblock %}