{% extends "base.njk" %}

{% block extraCss %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/github-dark.min.css" media="(prefers-color-scheme: dark)">
<link rel="stylesheet" href="/assets/css/article.css">
<link rel="stylesheet" href="/assets/css/ads.css">
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if schemaType == 'NewsArticle' or schemaType == 'BlogPosting' %}{{ schemaType }}{% else %}Article{% endif %}",
  "@id": {{ (site.url + page.url + '#article') | json | safe }},
  "headline": {{ title | json | safe }},
  "description": {{ description | json | safe }},
  "keywords": {{ (keywords or tags) | json | safe }},
  "articleSection": {{ category | json | safe }},
  "inLanguage": "en-US",
  "isAccessibleForFree": true,
  "image": [
    {{ (site.url + (ogImagePath | replace(' ', '%20'))) | json | safe }}
  ],
  "datePublished": {{ (date | isoDate) | json | safe }},
  "dateModified": {{ ((updated or date) | isoDate) | json | safe }},
  "author": {
    "@type": "Person",
    "name": {{ (author | default(site.author)) | json | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}{{ site.icon }}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ (site.url + page.url) | json | safe }}
  }
}
</script>
{% endblock %}

{% block content %}
<div class="article-page">
  <div class="container">
    <div class="article-layout">

      {% set shareUrl = site.url + page.url %}
      {% set shareTitle = title %}
      {% set shareText = title + " - " + description %}
      {% set shareImage = site.url + ogImagePath %}
      <aside class="share-rail" aria-label="Share this article">
        <span class="share-rail-label">Share</span>
        <a class="share-button share-facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Share on Facebook"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/facebook.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-x" href="https://twitter.com/intent/tweet?text={{ shareTitle | urlencode }}&url={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/x.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-linkedin" href="https://www.linkedin.com/sharing/share-offsite/?url={{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/linkedin.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-reddit" href="https://www.reddit.com/submit?url={{ shareUrl | urlencode }}&title={{ shareTitle | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit" title="Share on Reddit"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/reddit.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-whatsapp" href="https://wa.me/?text={{ shareText | urlencode }}%20{{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" title="Share on WhatsApp"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/whatsapp.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-telegram" href="https://t.me/share/url?url={{ shareUrl | urlencode }}&text={{ shareTitle | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Telegram" title="Share on Telegram"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/telegram.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-pinterest" href="https://www.pinterest.com/pin/create/button/?url={{ shareUrl | urlencode }}&media={{ shareImage | urlencode }}&description={{ shareTitle | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Save to Pinterest" title="Save to Pinterest"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/pinterest.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-tumblr" href="https://www.tumblr.com/widgets/share/tool?canonicalUrl={{ shareUrl | urlencode }}&title={{ shareTitle | urlencode }}&caption={{ description | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Tumblr" title="Share on Tumblr"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/tumblr.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-bluesky" href="https://bsky.app/intent/compose?text={{ shareText | urlencode }}%20{{ shareUrl | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Bluesky" title="Share on Bluesky"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/bluesky.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-hackernews" href="https://news.ycombinator.com/submitlink?u={{ shareUrl | urlencode }}&t={{ shareTitle | urlencode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Hacker News" title="Share on Hacker News"><img class="provider-logo" src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/ycombinator.svg" alt="" aria-hidden="true"></a>
        <a class="share-button share-email" href="mailto:?subject={{ shareTitle | urlencode }}&body={{ shareText | urlencode }}%0A%0A{{ shareUrl | urlencode }}" aria-label="Share by email" title="Share by email"><i data-lucide="mail"></i></a>
        <button class="share-button share-copy" type="button" data-copy-url="{{ shareUrl }}" aria-label="Copy article link" title="Copy article link"><i data-lucide="link"></i></button>
      </aside>

      <article class="article-body">
        <header class="article-header">
          <nav class="article-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/category/{{ category | slug }}/">{{ category }}</a>
            <span>›</span>
            <span aria-current="page">{{ title }}</span>
          </nav>

          <a href="/category/{{ category | slug }}/" class="badge">{{ category }}</a>
          <h1 class="article-title">{{ title }}</h1>

          <div class="article-meta">
            <span class="article-meta-item">
              <i data-lucide="calendar"></i>
              <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
            </span>
            <span class="article-meta-item">
              <i data-lucide="clock"></i>
              {{ readingTime }}
            </span>
          </div>
        </header>

        {{ content | safe }}

        <div class="article-footer-ads">
          {% set type = "in-content" %}
          {% include "ad-units.njk" %}
        </div>

        {% set relatedPosts = collections.posts | relatedPosts(category, page.url, 5) %}
        <section class="related-posts-mobile">
          <h3>You might also find helpful:</h3>
          <ul class="related-list">
            {% for post in relatedPosts %}
              <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      </article>

      <aside class="article-sidebar">
        {% set type = "sidebar" %}
        {% include "ad-units.njk" %}

        <div class="sidebar-related">
          <p class="sidebar-related-title">Related Articles</p>
          {% for post in relatedPosts %}
            <a href="{{ post.url }}" class="related-post-link">{{ post.data.title }}</a>
          {% endfor %}
        </div>
      </aside>

    </div>
  </div>
</div>
{% endblock %}

{% block extraJs %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js" defer></script>
<script src="/assets/js/article.js" defer></script>
{% endblock %}