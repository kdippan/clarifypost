<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{{ title }} — ClarifyPost</title>
  <meta name="description" content="{{ description }}">
  <meta name="author" content="ClarifyPost">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{{ title }} — ClarifyPost">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="ClarifyPost">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-default.png">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} — ClarifyPost">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/img/og-default.png">

  <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon.png">

  <meta name="msvalidate.01" content="BING_VERIFICATION_CODE">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">

  <link rel="stylesheet" href="/assets/css/main.css">
  {% block extraCss %}{% endblock %}

  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>

  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4Id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga4Id }}', {
      'article_cat': '{{ category }}',
      'read_time': '{{ readingTime }}',
      'schema_type': '{{ schemaType }}'
    });
  </script>

  {% block schema %}{% endblock %}
</head>
<body>

  {% include "header.njk" %}

  <main id="main-content" class="page-wrapper">
    {% block content %}{% endblock %}
  </main>

  {% include "footer.njk" %}

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js" defer></script>
  <script src="/assets/js/main.js" defer></script>
  {% block extraJs %}{% endblock %}

</body>
</html>