---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | xmlEscape | safe }}</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.tagline | xmlEscape | safe }}</description>
    <language>en</language>
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />
    {% for post in collections.posts %}
    <item>
      <title>{{ post.data.title | xmlEscape | safe }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <description>{{ post.data.description | xmlEscape | safe }}</description>
      <pubDate>{{ post.date | rfcDate }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>